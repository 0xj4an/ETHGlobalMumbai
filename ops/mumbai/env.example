# Copy to .env.miniklaim-mumbai on the VPS (never commit it). Secrets go here
# only; the values below without a secret are the demo defaults.

# Own database, copied once from production (see README.md). NOT production's.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/miniklaim_mumbai

# Game relayer key (same EOA as production: 0x8da26Ae1B32a7e4Cd158622D7d70Fe16D6F1dE83).
# In this instance it only signs Arkiv and ENS writes: every Celo address is zero.
SERVER_SIGNER_PRIVATE_KEY=

NEXT_PUBLIC_HEX_STRENGTH=on
# 720x: one game day = 2 minutes, one level of decay = 1 hour.
DEMO_TIME_SCALE=720

# Arkiv (Rabdi testnet)
ARKIV_SYNC=on
ARKIV_MAP=on
ARKIV_GAME=demo
ARKIV_ACCESS_KEY=
ARKIV_BATCH=50

# World ID (Developer Portal app). staging = World ID simulator.
WORLD_GATE=on
WORLD_ENVIRONMENT=staging
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=

# ENSv2 (Ethereum mainnet). Resolver comes from /mumbai/ens-setup.
ENS_TITLES=on
ENS_RESOLVER_ADDRESS=
ENS_RELAYER_ADDRESS=0x8da26Ae1B32a7e4Cd158622D7d70Fe16D6F1dE83
ENS_ZONES=[{"label":"bkc","cell":"87608b0b0ffffff"}]
ENS_MIN_INTERVAL=300
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
